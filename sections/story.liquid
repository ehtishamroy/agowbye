{%- style -%}
  .story__media-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 0.9s ease, transform 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .story__media-img.is-active {
    opacity: 1;
    transform: scale(1);
  }
{%- endstyle -%}

<section id="day" class="story scroll-mt-16 {{ section.settings.bg_color }}">
  <div class="wrap">
    <div class="story__header in" data-reveal="">
      {%- if section.settings.kicker != blank -%}
        <p class="kicker mb-3">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="text-h2 font-medium">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="text-muted mt-4 max-w-[56ch]">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="story__grid">
      <!-- Sticky image (desktop) -->
      <div class="story__media-col">
        <div class="story__media-sticky bg-stone" data-story-media="">
          {%- for block in section.blocks -%}
            {%- assign img_class = 'story__media-img' -%}
            {%- if forloop.first -%}
              {%- assign img_class = 'story__media-img is-active' -%}
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: 
                  sizes: '45vw',
                  class: img_class,
                  loading: 'lazy'
              }}
            {%- else -%}
              {%- capture placeholder_name -%}lifestyle-{% cycle '1', '2' %}{%- endcapture -%}
              {%- assign placeholder_class = img_class | append: ' bg-mist' -%}
              {{ placeholder_name | placeholder_svg_tag: placeholder_class }}
            {%- endif -%}
          {%- endfor -%}
          
          <div class="story__clock tnum" data-story-clock="">
            {%- if section.blocks.size > 0 -%}
              {{ section.blocks.first.settings.time | default: '7:40 am' }}
            {%- endif -%}
          </div>
        </div>
      </div>

      <!-- Chapters: a real sequence through one day -->
      <ol class="story__chapters" data-story-chapters>
        {%- for block in section.blocks -%}
          <li class="story__chapter" data-chapter="{{ forloop.index0 }}" data-time="{{ block.settings.time }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: 
                  sizes: '100vw',
                  class: 'story__chapter-img',
                  loading: 'lazy'
              }}
            {%- else -%}
              {%- capture placeholder_name_mob -%}lifestyle-{% cycle 'mob': '1', '2' %}{%- endcapture -%}
              {{ placeholder_name_mob | placeholder_svg_tag: 'story__chapter-img bg-mist' }}
            {%- endif -%}
            
            {%- if block.settings.time != blank -%}
              <p class="text-sm tnum text-muted">{{ block.settings.time }}</p>
            {%- endif -%}
            
            {%- if block.settings.title != blank -%}
              <h3 class="story__chapter-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            
            {%- if block.settings.text != blank -%}
              <p class="story__chapter-text">{{ block.settings.text }}</p>
            {%- endif -%}
            
            {%- if block.settings.label != blank -%}
              <p class="chip w-fit">{{ block.settings.label }}</p>
            {%- endif -%}
            
            {%- if block.settings.btn_text != blank -%}
              <a href="{{ block.settings.btn_link | default: '#' }}" class="btn btn-ink w-fit mt-2">{{ block.settings.btn_text }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

<script>
  (function() {
    function initStory() {
      const media = document.querySelector('[data-story-media]');
      if (!media) return;
      const imgs = media.querySelectorAll('.story__media-img');
      const clock = document.querySelector('[data-story-clock]');
      const chapters = document.querySelectorAll('[data-chapter]');
      if (!imgs.length || !chapters.length) return;

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (!e.isIntersecting) return;
            const i = +e.target.dataset.chapter;
            imgs.forEach((img, k) => img.classList.toggle('is-active', k === i));
            if (clock && e.target.dataset.time) {
              clock.textContent = e.target.dataset.time;
            }
          });
        }, { rootMargin: '-45% 0px -45% 0px' });

        chapters.forEach(c => io.observe(c));
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStory);
    } else {
      initStory();
    }
    document.addEventListener('shopify:section:load', initStory);
  })();
</script>

