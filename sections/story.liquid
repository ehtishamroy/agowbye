{%- style -%}
  .story__media-img {
    transition: opacity 0.4s ease-out;
    opacity: 0;
  }
  .story__media-img.is-active {
    opacity: 1;
  }
{%- endstyle -%}

<section id="day" class="story scroll-mt-16 {{ section.settings.bg_color }}">
  <div class="wrap">
    <div class="story__header in" data-reveal="">
      {%- if section.settings.kicker != blank -%}
        <p class="kicker mb-3">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="text-h2 font-medium">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="text-muted mt-4 max-w-[56ch]">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="story__grid">
      <!-- Sticky image (desktop) -->
      <div class="story__media-col">
        <div class="story__media-sticky bg-stone" data-story-media="">
          {%- for block in section.blocks -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: 
                  sizes: '45vw',
                  class: 'story__media-img',
                  loading: 'lazy',
                  data_index: forloop.index0
              }}
            {%- else -%}
              {%- capture placeholder_name -%}lifestyle-{% cycle '1', '2' %}{%- endcapture -%}
              {%- capture svg_replace -%}<svg data-index="{{ forloop.index0 }}"{%- endcapture -%}
              {{ placeholder_name | placeholder_svg_tag: 'story__media-img bg-mist' | replace: '<svg', svg_replace }}
            {%- endif -%}
          {%- endfor -%}
          
          <div class="story__clock tnum" data-story-clock="">
            {%- if section.blocks.size > 0 -%}
              {{ section.blocks.first.settings.time | default: '7:40 am' }}
            {%- endif -%}
          </div>
        </div>
      </div>

      <!-- Chapters: a real sequence through one day -->
      <ol class="story__chapters" data-story-chapters>
        {%- for block in section.blocks -%}
          <li class="story__chapter" data-chapter="{{ forloop.index0 }}" data-time="{{ block.settings.time }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: 
                  sizes: '100vw',
                  class: 'story__chapter-img',
                  loading: 'lazy'
              }}
            {%- else -%}
              {%- capture placeholder_name_mob -%}lifestyle-{% cycle 'mob': '1', '2' %}{%- endcapture -%}
              {{ placeholder_name_mob | placeholder_svg_tag: 'story__chapter-img bg-mist' }}
            {%- endif -%}
            
            {%- if block.settings.time != blank -%}
              <p class="text-sm tnum text-muted">{{ block.settings.time }}</p>
            {%- endif -%}
            
            {%- if block.settings.title != blank -%}
              <h3 class="story__chapter-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            
            {%- if block.settings.text != blank -%}
              <p class="story__chapter-text">{{ block.settings.text }}</p>
            {%- endif -%}
            
            {%- if block.settings.label != blank -%}
              <p class="chip w-fit">{{ block.settings.label }}</p>
            {%- endif -%}
            
            {%- if block.settings.btn_text != blank -%}
              <a href="{{ block.settings.btn_link | default: '#' }}" class="btn btn-ink w-fit mt-2">{{ block.settings.btn_text }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const chapters = document.querySelectorAll('[data-chapter]');
    const desktopImages = document.querySelectorAll('.story__media-img');
    const clockBadge = document.querySelector('[data-story-clock]');
    
    if (!chapters.length || !desktopImages.length) return;

    // Set first image active initially
    desktopImages[0].classList.add('is-active');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const index = parseInt(entry.target.getAttribute('data-chapter'));
          const time = entry.target.getAttribute('data-time');
          
          // Update images
          desktopImages.forEach(img => img.classList.remove('is-active'));
          const activeImg = Array.from(desktopImages).find(img => parseInt(img.getAttribute('data-index') || img.getAttribute('data-index')) === index) || desktopImages[index];
          if (activeImg) {
            activeImg.classList.add('is-active');
          }
          
          // Update clock
          if (clockBadge && time) {
            clockBadge.textContent = time;
          }
        }
      });
    }, {
      rootMargin: '-40% 0px -40% 0px', // Trigger when chapter hits the middle 20% of the screen
      threshold: 0
    });

    chapters.forEach(chapter => observer.observe(chapter));
  });
</script>

