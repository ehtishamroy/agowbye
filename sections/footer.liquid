<footer id="contact" class="footer scroll-mt-16">
  <div class="wrap footer__grid">
    <!-- Left column -->
    <div class="footer__brand">
      {%- if section.settings.logo != blank -%}
        <a href="{{ routes.root_url }}" class="footer__logo" aria-label="{{ shop.name | escape }}">
          {{ section.settings.logo | image_url: width: 320 | image_tag: class: 'footer__logo-img', alt: shop.name, loading: 'lazy', widths: '160, 320' }}
        </a>
      {%- else -%}
        <span class="footer__logo-text">{{ section.settings.logo_text }}</span>
      {%- endif -%}
      <div class="footer__desc text-muted" style="margin-bottom: 1.5rem;">{{ section.settings.text }}</div>
      <div class="footer__newsletter">
        {%- form 'customer', class: 'newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div style="display:flex; gap:0.5rem; max-width: 320px;">
            <input type="email" name="contact[email]" placeholder="Email address" required style="flex:1; padding:0.5rem 0.75rem; border:1px solid var(--line); border-radius:4px; font-size:0.875rem; width:100%;">
            <button type="submit" style="padding:0.5rem 1rem; background:var(--ink); color:#fff; border:none; border-radius:4px; cursor:pointer; font-size:0.875rem; font-weight:500;">Subscribe</button>
          </div>
        {%- endform -%}
      </div>
    </div>

    <!-- Right column (Menus) -->
    <div class="footer__menus">
      {%- for block in section.blocks -%}
        <div class="footer__menu-col" {{ block.shopify_attributes }}>
          <p class="footer__menu-title">{{ block.settings.title }}</p>
          {%- if block.type == 'menu' -%}
            {%- for link in block.settings.menu.links -%}
              <a href="{{ link.url }}" class="footer__menu-link">{{ link.title }}</a>
            {%- endfor -%}
          {%- elsif block.type == 'text_block' -%}
            <div class="footer__menu-richtext text-muted">
              {{ block.settings.text }}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="wrap footer__bottom">
    <p>&copy; <span data-year="">{{ 'now' | date: '%Y' }}</span> {{ section.settings.copyright_text }}</p>
    <div class="footer__bottom-links">
      {%- for link in section.settings.bottom_menu.links -%}
        <a href="{{ link.url }}" class="footer__bottom-link">{{ link.title }}</a>
      {%- endfor -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Replaces the logo text below when set."
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "info": "Fallback when no logo image is set.",
      "default": "agow"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>One well-made stroller for Canadian families. Designed for real days, tested in real weather.</p>"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "AGOW. Canada."
    },
    {
      "type": "link_list",
      "id": "bottom_menu",
      "label": "Bottom menu"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },

    {
      "type": "text_block",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "AGOW"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>hello@agow.ca</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
