<footer id="contact" class="footer scroll-mt-16">
  <div class="wrap footer__grid">
    <!-- Left column -->
    <div class="footer__brand">
      <span class="footer__logo-text">{{ section.settings.logo_text }}</span>
      <div class="footer__desc text-muted">{{ section.settings.text }}</div>
    </div>

    <!-- Right column (Menus) -->
    <div class="footer__menus">
      {%- for block in section.blocks -%}
        <div class="footer__menu-col" {{ block.shopify_attributes }}>
          <p class="footer__menu-title">{{ block.settings.title }}</p>
          {%- if block.type == 'menu' -%}
            {%- for link in block.settings.menu.links -%}
              <a href="{{ link.url }}" class="footer__menu-link">{{ link.title }}</a>
            {%- endfor -%}
          {%- elsif block.type == 'text_block' -%}
            <div class="footer__menu-richtext text-muted">
              {{ block.settings.text }}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="wrap footer__bottom">
    <p>&copy; <span data-year="">{{ 'now' | date: '%Y' }}</span> {{ section.settings.copyright_text }}</p>
    <div class="footer__bottom-links">
      {%- for link in section.settings.bottom_menu.links -%}
        <a href="{{ link.url }}" class="footer__bottom-link">{{ link.title }}</a>
      {%- endfor -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "agow"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>One well-made stroller for Canadian families. Designed for real days, tested in real weather.</p>"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "AGOW. Canada."
    },
    {
      "type": "link_list",
      "id": "bottom_menu",
      "label": "Bottom menu"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text_block",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "AGOW"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>hello@agow.ca</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
